{
  "name": "code-forces-ranked",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "sync": "node --env-file-if-exists=.env.local scripts/sync.mts",
    "up": "npm run setup",
    "setup": "npm run env && docker compose up -d --wait && drizzle-kit push && npm run sync && next dev",
    "env": "node scripts/ensure-env.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-query": "^5.103.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.47.0",
    "nanoid": "^6.0.1",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "description": "Solo ranked practice for Codeforces — rated problems near your level, hidden tags, an interview-length timer, and an Elo rating you have to earn.",
  "keywords": [
    "codeforces",
    "competitive-programming",
    "elo",
    "rating",
    "practice",
    "algorithms",
    "interview-prep",
    "pomodoro",
    "nextjs",
    "shadcn-ui",
    "drizzle",
    "postgres",
    "self-hosted"
  ],
  "license": "MIT"
}
